{
  "name": "uagray",
  "version": "0.1.0-beta.1",
  "type": "module",
  "scripts": {
    "build": "npm run check && vite build",
    "check": "tsc -b && npm run check:design",
    "test": "vitest run src lab && npm run test:design",
    "verify:consumer": "npm pack && node scripts/verify-consumer.mjs",
    "format": "prettier --write src docs README.md index.html package.json tsconfig*.json vite*.config.ts",
    "prepack": "npm run build:lib",
    "dev": "vite",
    "fonts": "node scripts/build-fonts.mjs",
    "build:lib": "npm run check && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && rm -rf dist/fonts && cp -R fonts dist/fonts",
    "check:design": "node scripts/check-design.mjs",
    "test:design": "node --test scripts/check-design.test.mjs",
    "dev:lab": "vite --config vite.lab.config.ts",
    "test:lab": "vitest run lab"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.8",
    "@uplus-icon/react": "0.1.0-beta.0",
    "framer-motion": "^14.0.0",
    "react-aria-components": "^1.22.0",
    "@uplus-icon/core": "^0.1.0-beta.1"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@ibm/plex-sans": "^1.1.0",
    "@ibm/plex-sans-sc": "^1.1.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts/fonts.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "description": "A lightweight grayscale React design system.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Upper-Hank/uagray.git"
  },
  "homepage": "https://github.com/Upper-Hank/uagray#readme",
  "bugs": {
    "url": "https://github.com/Upper-Hank/uagray/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  }
}
