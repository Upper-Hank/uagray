{
  "name": "uagray",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run check && vite build && tsc -p tsconfig.lib.json",
    "check": "tsc -b",
    "test": "vitest run src/ui",
    "format": "prettier --write src docs README.md package.json tsconfig*.json vite.config.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.8",
    "@uplus-icon/react": "0.1.0-beta.0",
    "framer-motion": "^14.0.0",
    "react-aria-components": "^1.22.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
